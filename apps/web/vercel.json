{
  "redirects": [
    {
      "source": "/sites/:slug",
      "destination": "/:slug",
      "permanent": true
    },
    {
      "source": "/sites/:slug/:path*",
      "destination": "/:slug/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://loohar-api.onrender.com/api/:path*"
    },
    {
      "source": "/health",
      "destination": "https://loohar-api.onrender.com/health"
    },
    {
      "source": "/version",
      "destination": "/version.json"
    },
    {
      "source": "/:slug/sitemap.xml",
      "destination": "https://loohar-api.onrender.com/api/public/restaurants/:slug/sitemap.xml"
    },
    {
      "source": "/:slug/robots.txt",
      "destination": "https://loohar-api.onrender.com/api/public/restaurants/:slug/robots.txt"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/download/(.*).apk.json",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/download/(.*).apk",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/vnd.android.package-archive"
        },
        {
          "key": "Content-Disposition",
          "value": "attachment"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=300"
        }
      ]
    },
    {
      "source": "/version",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/version.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self'"
        }
      ]
    }
  ]
}
